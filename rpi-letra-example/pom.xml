<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>in.virit</groupId>
    <artifactId>rpi-letra-example</artifactId>
    <name>rpi-letra-example</name>
    <packaging>jar</packaging>
    <version>1.0-SNAPSHOT</version>

    <description>
        Headless Java bridge for a Raspberry Pi: discovers a Dymo LetraTag 200B over
        BLE, connects to a WebSocket server at wss://w.virit.in/ws/printer, and
        prints any text frame the server broadcasts. An alternative to the browser-side
        Web Bluetooth driver — the server talks to the device over the network instead
        of through a user's browser.
    </description>

    <properties>
        <bluez.dbus.version>0.1.4</bluez.dbus.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>in.virit</groupId>
            <artifactId>dymo-letratag-200b</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <!-- (Ab)using part of the WebBluetooth "driver", don't pull in whole Vaadin -->
            <exclusions>
                <exclusion>
                    <groupId>com.vaadin</groupId>
                    <artifactId>vaadin-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>com.github.hypfvieh</groupId>
            <artifactId>bluez-dbus</artifactId>
            <version>${bluez.dbus.version}</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>rpi-letra-example</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>in.virit.rpi.RpiLetraTagApp</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
